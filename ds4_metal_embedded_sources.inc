    "    for (int i = tpitg.x; i < args.n_in; i += ntg.x) {\n"
    "        const float xv = xr[i];\n"
    "        sumsq += xv * xv;\n"
    "        for (int j = 0; j < args.out_dim && j < MAX_OUT; ++j) {\n"
