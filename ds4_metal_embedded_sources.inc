    "                       args.ext_factor, args.attn_factor, &cos_theta, &sin_theta);\n"
    "        const int j0 = n_nope + r;\n"
    "        const int j1 = j0 + 1;\n"
    "        const float x0 = x[j0] * scale * weight[j0];\n"
    "        const float x1 = x[j1] * scale * weight[j1];\n"
