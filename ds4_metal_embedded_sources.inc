    " device const char * kv,\n"
    " device const char * score,\n"
    " device char * dst,\n"
    " uint gid [[thread_position_in_grid]]) {\n"
    " const int64_t n = args.ne0 * args.ne1;\n"
    " if ((int64_t) gid >= n) {\n"
    " return;\n"
    " }\n"
    "\n"
    " const int64_t id = gid % args.ne0;\n"
    " const int64_t ic = gid / args.ne0;\n"
    "\n"
    " float max_s = -INFINITY;\n"
