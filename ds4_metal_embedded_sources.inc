    "    device const float *  psrc2 = src2 != src0 ? (device const float * ) (src2)                                                 : nullptr;\n"
    "    device       float4 * pdst4 =                (device       float4 *) (dst  + i01*args.nb1  + i02*args.nb2  + i03*args.nb3);\n"
