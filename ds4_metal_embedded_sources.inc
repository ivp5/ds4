    "    const float scale = 1.0f / sqrt(sumf / float(n) + args.eps);\n"
    "#else\n"
    "    const float scale = rsqrt(sumf / float(n) + args.eps);\n"
    "#endif\n"
    "\n"
    "    for (int i = tpitg.x; i < n4; i += ntg.x) {\n"
    "        y[i] = (x[i] * scale) * w[i];\n"
    "    }\n"
    "}\n"
