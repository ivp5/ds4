    "    float lsum = 0.0f;\n"
    "    for (int i00 = tpitg.x; i00 < args.ne00; i00 += tptg.x) {\n"
    "        const float exp_psrc0 = exp((psrc0[i00]*args.scale + (pmask ? slope*pmask[i00] : 0.0f)) - max_val);\n"
