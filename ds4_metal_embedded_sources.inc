    "kernel void kernel_dsv4_output_hc_rms_f16_mix_sum_norm4(\n"
    "        constant ds4_metal_args_dsv4_output_hc_rms_mix_sum_norm & args,\n"
    "        device  const half  * pre_weight,\n"
    "        device  const float * scale,\n"
    "        device  const float * base,\n"
    "        device  const char  * x,\n"
    "        device        char  * pre_dst,\n"
    "        device        char  * weights,\n"
