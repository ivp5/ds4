    "\n"
    "struct ds4_metal_args_dsv4_ratio4_shift {\n"
    "    uint32_t width;\n"
    "};\n"
    "\n"
    "struct ds4_metal_args_dsv4_compressor_store_one {\n"
    "    uint32_t width;\n"
    "    uint32_t ratio;\n"
    "    uint32_t pos;\n"
    "    uint32_t ape_type;\n"
