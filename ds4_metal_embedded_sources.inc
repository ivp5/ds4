    "    const int n_nope = args.head_dim - args.n_rot;\n"
    "    for (int i = tid; i < n_nope; i += ntg) {\n"
    "        out[i] = x[i] * scale * weight[i];\n"
    "    }\n"
    "    if (args.n_rot == 0) return;\n"
    "\n"
    "    float corr_dims[2];\n"
    "    norm_rope_yarn_corr_dims(args.n_rot, args.n_ctx_orig, args.freq_base,\n"
    "                             args.beta_fast, args.beta_slow, corr_dims);\n"
    "    const float theta_base = float(args.pos);\n"
