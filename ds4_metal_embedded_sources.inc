    "        out[j1] = x0 * sin_theta + x1 * cos_theta;\n"
    "    }\n"
    "}\n"
    "\n"
    "struct ds4_metal_args_hc_rms_f16_mix {\n"
    "    int32_t n_in;\n"
    "    int32_t out_dim;\n"
