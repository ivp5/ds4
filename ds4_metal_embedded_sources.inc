    "struct D8FDownLutArgs {\n"
    "  uint rows;\n"
    "  uint in_dim;\n"
    "  uint n_selected;\n"
    "  uint n_tokens;\n"
    "  uint table_offset;\n"
    "  uint record_bytes;\n"
