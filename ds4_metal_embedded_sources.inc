    "static inline void dsv4_attend_shared_h4_row_at(\n"
    " threadgroup const half4 *kv4,\n"
    " uint row_in_tg,\n"
    " half4 q0,\n"
    " half4 q1,\n"
    " half4 q2,\n"
    " half4 q3,\n"
    " float scale,\n"
    " ushort lane,\n"
    " thread float &M,\n"
    " thread float &S,\n"
