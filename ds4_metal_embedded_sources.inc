    "    float4 lsum4 = 0.0f;\n"
    "    for (int i00 = tpitg.x; i00 < args.ne00/4; i00 += tptg.x) {\n"
    "        const float4 exp_psrc4 = exp((psrc4[i00]*args.scale + (float4)((pmask ? slope*pmask[i00] : 0.0f))) - max_val);\n"
